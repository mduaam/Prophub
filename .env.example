# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Meta Conversions API (CAPI) & Pixel
# Configure these to enable live transmission to Meta Ads Graph API
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""

# Meta Cloud API / WhatsApp Webhook
# Set your webhook verification token for Meta Developer portal
WHATSAPP_VERIFY_TOKEN="propengine_verify_token_2026"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Supabase (Optional for direct PostgreSQL synchronization)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Upstash Redis (Optional for distributed rate-limiting and conversation cache)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
